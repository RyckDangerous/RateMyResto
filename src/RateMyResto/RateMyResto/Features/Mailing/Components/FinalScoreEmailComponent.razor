@namespace RateMyResto.Features.Mailing.Components

<!DOCTYPE html>
<html lang="fr" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Le verdict est tombé — RateMyResto</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
    <style type="text/css">
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
        img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
        body { margin: 0; padding: 0; background-color: #f4f4f5; }
        a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
    </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f5;">

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
           style="background-color: #f4f4f5;">
        <tr>
            <td align="center" style="padding: 40px 16px;">

                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
                       style="max-width: 600px; width: 100%;">

                    <!-- HEADER -->
                    <tr>
                        <td align="center" bgcolor="#c62828"
                            style="background-color: #c62828; border-radius: 12px 12px 0 0; padding: 36px 40px 32px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                <tr>
                                    <td align="center" style="font-size: 46px; padding-bottom: 12px;">
                                        🍽️
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center"
                                        style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 28px; font-weight: 700; color: #ffffff;
                                               letter-spacing: 0.5px; padding-bottom: 8px;">
                                        RateMyResto
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center"
                                        style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 14px; color: rgba(255,255,255,0.80); line-height: 1.4;">
                                        Notez vos expériences, partagez vos coups de cœur
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- BODY -->
                    <tr>
                        <td bgcolor="#ffffff"
                            style="background-color: #ffffff; padding: 44px 44px 36px;
                                   border-left: 1px solid #e4e4e7; border-right: 1px solid #e4e4e7;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">

                                <!-- Salutation -->
                                <tr>
                                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 22px; font-weight: 600; color: #111111;
                                               padding-bottom: 20px;">
                                        Bonjour @DisplayName,
                                    </td>
                                </tr>

                                <!-- Intro -->
                                <tr>
                                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 16px; line-height: 1.75; color: #444444;
                                               padding-bottom: 32px;">
                                        Le jury a rendu son verdict&nbsp;! Tous les membres de l'équipe
                                        <strong style="color: #111111;">@NomEquipe</strong>
                                        ont exprimé leur avis sur le repas chez
                                        <strong style="color: #111111;">@NomRestaurant</strong>.
                                        La note officielle est maintenant disponible.
                                    </td>
                                </tr>

                                <!-- Fiche événement -->
                                <tr>
                                    <td style="padding-bottom: 36px;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                                               style="background-color: #fef9f9; border: 1px solid #fddcdc;
                                                      border-left: 5px solid #e53935; border-radius: 0 8px 8px 0;">
                                            <tr>
                                                <td style="padding: 24px 28px;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">

                                                        <tr>
                                                            <td style="padding-bottom: 16px;">
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 11px; font-weight: 700; text-transform: uppercase;
                                                                            letter-spacing: 0.8px; color: #e53935; padding-bottom: 4px;">
                                                                    Restaurant
                                                                </div>
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 16px; font-weight: 600; color: #111111;">
                                                                    @NomRestaurant
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td style="padding-bottom: 16px;">
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 11px; font-weight: 700; text-transform: uppercase;
                                                                            letter-spacing: 0.8px; color: #e53935; padding-bottom: 4px;">
                                                                    Équipe
                                                                </div>
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 16px; font-weight: 600; color: #111111;">
                                                                    @NomEquipe
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <tr>
                                                            <td>
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 11px; font-weight: 700; text-transform: uppercase;
                                                                            letter-spacing: 0.8px; color: #e53935; padding-bottom: 4px;">
                                                                    Date du repas
                                                                </div>
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 16px; font-weight: 600; color: #111111;">
                                                                    @FormattedDate
                                                                </div>
                                                            </td>
                                                        </tr>

                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Bloc note globale -->
                                <tr>
                                    <td align="center" style="padding-bottom: 12px;">

                                        <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                    font-size: 12px; font-weight: 700; text-transform: uppercase;
                                                    letter-spacing: 1px; color: #888888; padding-bottom: 20px;">
                                            Note officielle de l'équipe
                                        </div>

                                        <!-- Badge score -->
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                                               align="center" style="margin: 0 auto;">
                                            <tr>
                                                <td align="center" valign="middle"
                                                    style="width: 120px; height: 120px;
                                                           background-color: @ScoreColor;
                                                           border-radius: 60px;
                                                           text-align: center; vertical-align: middle;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="120" height="120">
                                                        <tr>
                                                            <td align="center" valign="middle">
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 42px; font-weight: 800; color: #ffffff; line-height: 1;">
                                                                    @NoteGlobale
                                                                </div>
                                                                <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                                            font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.75);
                                                                            letter-spacing: 0.5px; margin-top: 2px;">
                                                                    sur 5
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- Étoiles -->
                                        <div style="font-size: 28px; letter-spacing: 4px; margin-top: 16px; line-height: 1;">
                                            @for (int i = 0; i < FilledStars; i++)
                                            {
                                                <span style="color: @StarFilledColor;">★</span>
                                            }
                                            @for (int i = 0; i < EmptyStars; i++)
                                            {
                                                <span style="color: @StarEmptyColor;">★</span>
                                            }
                                        </div>

                                        <!-- Verdict -->
                                        <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                    font-size: 18px; font-weight: 700; color: @ScoreColor;
                                                    margin-top: 12px; letter-spacing: 0.3px;">
                                            @ScoreLabel
                                        </div>

                                    </td>
                                </tr>

                                <!-- Spacer -->
                                <tr><td style="height: 36px;">&nbsp;</td></tr>

                                <!-- CTA -->
                                <tr>
                                    <td align="center" style="padding-bottom: 36px;">
                                        <!--[if mso]>
                                        <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml"
                                                     xmlns:w="urn:schemas-microsoft-com:office:word"
                                                     href="@EventDetailUrl"
                                                     style="height:52px; v-text-anchor:middle; width:340px;"
                                                     arcsize="15%" strokecolor="#1b5e20" fillcolor="#2e7d32">
                                            <w:anchorlock/>
                                            <center style="color:#ffffff; font-family:sans-serif; font-size:16px; font-weight:bold;">
                                                Voir les détails de l'événement →
                                            </center>
                                        </v:roundrect>
                                        <![endif]-->
                                        <!--[if !mso]><!-->
                                        <a href="@EventDetailUrl"
                                           style="background-color: #2e7d32; color: #ffffff; text-decoration: none;
                                                  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                                  font-size: 16px; font-weight: 700; padding: 16px 40px;
                                                  border-radius: 8px; display: inline-block; letter-spacing: 0.3px;">
                                            Voir les détails de l'événement&nbsp;→
                                        </a>
                                        <!--<![endif]-->
                                    </td>
                                </tr>

                                <!-- Divider -->
                                <tr>
                                    <td style="padding-bottom: 24px;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td style="border-top: 1px solid #eeeeee; font-size: 0; line-height: 0;">&nbsp;</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>

                                <!-- Message de clôture -->
                                <tr>
                                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 15px; line-height: 1.65; color: #666666;
                                               padding-bottom: 12px;">
                                        Merci à tous pour votre participation&nbsp;! Retrouvez le détail des avis
                                        et les photos de la soirée directement sur la page de l'événement.
                                        À très bientôt pour le prochain repas d'équipe&nbsp;!
                                    </td>
                                </tr>

                                <!-- Signature -->
                                <tr>
                                    <td style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 15px; font-weight: 600; color: #333333;">
                                        L'équipe RateMyResto
                                    </td>
                                </tr>

                            </table>
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td bgcolor="#f9f9f9" align="center"
                            style="background-color: #f9f9f9; border: 1px solid #e4e4e7; border-top: none;
                                   border-radius: 0 0 12px 12px; padding: 20px 40px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                <tr>
                                    <td align="center"
                                        style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
                                               font-size: 12px; color: #aaaaaa; line-height: 1.6;">
                                        Ce message est une notification automatique envoyée par RateMyResto.<br />
                                        Si vous pensez avoir reçu cet email par erreur, merci de l'ignorer.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>
</html>
