@page "/account/manage-users"
@using RateMyResto.Features.Account.ManageAccountFeature.Services
@using RateMyResto.Features.Account.ManageAccountFeature.Models
@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Gestion des utilisateurs</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 mb-2">
                <i class="bi bi-people-fill text-primary me-2"></i>Gestion des comptes
            </h1>
            <p class="text-muted">Réinitialisez les mots de passe des utilisateurs. Réservé aux administrateurs.</p>
        </div>
    </div>

    @if (!_viewService.ViewModel.IsAdmin)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Accès refusé</strong>
            <p class="mb-0 mt-2">Vous devez être connecté en tant qu'administrateur pour accéder à cette page.</p>
        </div>
    }
    else if (_viewService.ViewModel.IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Chargement des utilisateurs...</p>
        </div>
    }
    else if (!_viewService.ViewModel.Users.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Aucun utilisateur à gérer (hormis le compte administrateur).
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person-lines-fill me-2"></i>Liste des utilisateurs
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Utilisateur</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _viewService.ViewModel.Users)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-person-circle me-2 text-muted"></i>
                                        <strong>@user.UserName</strong>
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-outline-warning btn-sm"
                                                @onclick="() => _viewService.OpenResetPasswordModal(user.Id, user.UserName)">
                                            <i class="bi bi-key me-1"></i>Reset mot de passe
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modale de reset de mot de passe -->
@if (_viewService.ShowResetPasswordModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-key me-2"></i>Réinitialiser le mot de passe
                    </h5>
                    <button type="button" class="btn-close" @onclick="_viewService.CloseResetPasswordModal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        <i class="bi bi-person me-2"></i>
                        Nouveau mot de passe pour : <strong>@_viewService.SelectedUserName</strong>
                    </p>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">Nouveau mot de passe <span class="text-danger">*</span></label>
                        <input type="password"
                               class="form-control"
                               id="newPassword"
                               @bind="_viewService.NewPassword"
                               @bind:event="oninput"
                               placeholder="Saisissez le nouveau mot de passe"
                               autocomplete="new-password" />
                        <div class="small text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i>Règles à respecter :
                            <ul class="mb-0 mt-1 ps-3">
                                <li>Minimum 6 caractères</li>
                                <li>Au moins un chiffre</li>
                                <li>Au moins un caractère spécial (ex. !, &#64;, #, $)</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="_viewService.CloseResetPasswordModal">
                        <i class="bi bi-x-circle me-1"></i>Annuler
                    </button>
                    <button type="button"
                            class="btn btn-warning"
                            @onclick="_viewService.HandleResetPasswordAsync"
                            disabled="@(!_viewService.IsNewPasswordValid)">
                        <i class="bi bi-check-circle me-1"></i>Valider
                    </button>
                </div>
            </div>
        </div>
    </div>
}
